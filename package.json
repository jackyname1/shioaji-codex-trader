{
  "name": "shioaji-codex-trader",
  "version": "0.2.3",
  "private": true,
  "description": "Shioaji market workbench with Codex strategies and historical simulation",
  "main": "dist/src/desktop/main.js",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc && node scripts/assets.ts",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "demo": "npm run build && node dist/src/cli.js --demo",
    "start": "npm run prepare:broker && npm run build && electron .",
    "doctor": "npm run build && node dist/src/cli.js --doctor",
    "prepare:broker": "node scripts/prepare-broker.ts",
    "pack:win": "npm run prepare:broker -- --platform=win32 --arch=x64 && npm run build && electron-builder --win portable --x64",
    "backtest:demo": "npm run build && node dist/src/cli.js --backtest --start=2026-10-01 --end=2026-10-08 --source=sample --strategy=demo"
  },
  "dependencies": {
    "@openai/codex-sdk": "0.161.0",
    "decimal.js": "10.6.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "typescript": "7.0.2"
  },
  "build": {
    "appId": "tw.shioaji.codex.trader",
    "productName": "Shioaji Codex Trader",
    "asar": true,
    "files": [
      "dist/src/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "asarUnpack": [
      "node_modules/@openai/codex*/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/shioaji",
        "to": "shioaji"
      }
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": true,
      "icon": "src/desktop/assets/app.ico"
    },
    "portable": {
      "artifactName": "Shioaji-Codex-Trader-${version}-Windows-x64.exe"
    },
    "directories": {
      "output": "release"
    }
  }
}
